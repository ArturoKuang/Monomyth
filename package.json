{
  "name": "monomyth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.0.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --grep-invert '@visual|@perf'",
    "test:visual": "npm run build && playwright test --grep @visual",
    "test:perf": "npm run build && playwright test --grep @perf",
    "test:browser": "npm run build && playwright test",
    "scan:secrets": "node security-check.mjs source",
    "scan:staged": "node security-check.mjs staged",
    "scan:history": "node security-check.mjs history",
    "scan:artifacts": "node security-check.mjs artifacts",
    "audit:dependencies": "npm audit --audit-level=high",
    "build": "npm run typecheck && vite build && npm run scan:artifacts",
    "check": "npm run format:check && npm run lint && npm run scan:secrets && npm run test:coverage && npm run test:browser",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "pure-rand": "8.4.2",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
